<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/_5sdp"
                android:background="@color/colorBlack"
                android:orientation="horizontal">
                <TextView
                    android:id="@+id/tvcutomercode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/Base.TextAppearance.AppCompat.Subhead"
                    android:textColor="@color/colorWhite"
                    app:fontPath="@string/regular_font"
                    android:textSize="@dimen/_10sdp"
                    android:gravity="center"
                    android:layout_weight="1"

                    tools:text="Customer Code" />
                <TextView
                    android:id="@+id/tvCustomerName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/Base.TextAppearance.AppCompat.Subhead"
                    android:textColor="@color/colorWhite"
                    app:fontPath="@string/regular_font"
                    android:textSize="@dimen/_10sdp"
                    android:gravity="center"
                    android:layout_weight="1"
                    tools:text="Customer Code" />
                <TextView
                    android:id="@+id/tvInvoceNo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/Base.TextAppearance.AppCompat.Subhead"
                    android:textColor="@color/colorWhite"
                    app:fontPath="@string/regular_font"
                    android:textSize="@dimen/_10sdp"
                    android:gravity="center"
                    android:layout_weight="1"
                    tools:text="Invoice No" />
                <TextView
                    android:id="@+id/tvNetSale"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/Base.TextAppearance.AppCompat.Subhead"
                    android:textColor="@color/colorWhite"
                    app:fontPath="@string/regular_font"
                    android:textSize="@dimen/_10sdp"
                    android:gravity="center"
                    android:layout_weight="1"
                    tools:text="Net Sale" />

                <TextView
                    android:id="@+id/tvTotalsale"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/Base.TextAppearance.AppCompat.Subhead"
                    android:textColor="@color/colorWhite"
                    app:fontPath="@string/regular_font"
                    android:textSize="@dimen/_10sdp"
                    android:gravity="center"
                    android:layout_weight="1"
                    tools:text="Total Sale" />

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewEndrose"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>