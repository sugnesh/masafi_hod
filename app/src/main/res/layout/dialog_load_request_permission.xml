<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/tools"
    app:ignore="NamespaceTypo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:card_view="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            card_view:cardBackgroundColor="@android:color/white"
            card_view:cardCornerRadius="6dp"
            card_view:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_10sdp"
                android:orientation="vertical"
                android:padding="@dimen/_10sdp">

                <TextView
                    android:id="@+id/txt_name"
                    fontPath="@string/regular_font"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="center"
                    android:maxEms="12"
                    android:text="Confirmation"
                    android:textAppearance="@style/Base.TextAppearance.AppCompat.Medium"
                    android:textColor="@color/colorPrimary" />

                <TextView
                    android:id="@+id/txt_msg"
                    android:layout_marginTop="@dimen/_5sdp"
                    fontPath="@string/bold_font"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:maxEms="12"
                    android:text="You are not at Loading area in warehouse. Click on Yes you send request to the supervisor for approval."
                    android:textAppearance="@style/Base.TextAppearance.AppCompat.Small" />



                <LinearLayout
                    android:id="@+id/ll_btn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_20sdp"
                    android:layout_marginBottom="@dimen/_20sdp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnConfirm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/_20sdp"
                        android:backgroundTint="@color/colorButtonBg"
                        android:paddingLeft="@dimen/_22sdp"
                        android:paddingTop="@dimen/_10sdp"
                        android:paddingRight="@dimen/_22sdp"
                        android:paddingBottom="@dimen/_10sdp"
                        android:text="Yes"
                        android:textColor="@color/colorWhite"
                        app:cornerRadius="@dimen/_30sdp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCancel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_20sdp"
                        android:backgroundTint="@color/colorGrey_200"
                        android:paddingLeft="@dimen/_22sdp"
                        android:paddingTop="@dimen/_10sdp"
                        android:paddingRight="@dimen/_22sdp"
                        android:paddingBottom="@dimen/_10sdp"
                        android:text="No"
                        android:textColor="@color/colorWhite"
                        app:cornerRadius="@dimen/_30sdp" />

                </LinearLayout>


            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</layout>