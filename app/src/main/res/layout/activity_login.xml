<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".activity.LoginActivity">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/iv_bg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scaleType="fitXY"
            android:tint="@color/colorPrimary"
            android:src="@mipmap/ic_login"
            android:translationY="-200dp" />

        <LinearLayout
            android:id="@+id/ll_top"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="30dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="20dp"
                android:text="Login"
                android:textColor="@color/colorWhite"
                android:textSize="@dimen/_20sdp"
                app:fontPath="@string/bold_font" />

            <View
                android:layout_width="40dp"
                android:layout_height="2dp"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="8dp"
                android:background="@color/colorWhite" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="30dp"
                android:text="Email"
                android:textColor="@color/colorWhite"
                android:textSize="@dimen/_12sdp" />

            <EditText
                android:id="@+id/et_username"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                android:backgroundTint="@color/colorWhite"
                android:inputType="textEmailAddress"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:singleLine="true"
                android:textColor="@color/colorWhite"
                android:textCursorDrawable="@null"
                android:textSize="@dimen/_12sdp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_marginTop="24dp"
                android:text="Password"
                android:textColor="@color/colorWhite"
                android:textSize="@dimen/_14sdp" />

            <EditText
                android:id="@+id/et_password"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_30sdp"
                android:backgroundTint="@color/colorWhite"
                android:inputType="textPassword"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:singleLine="true"
                android:textColor="@color/colorWhite"
                android:textCursorDrawable="@null"
                android:textSize="@dimen/_14sdp" />


            <RadioGroup
                android:visibility="gone"
                android:id="@+id/rgLoginType"
                android:layout_width="match_parent"
                android:layout_height="@dimen/_20sdp"
                android:layout_marginTop="@dimen/_10sdp"
                android:orientation="horizontal"
                android:theme="@style/MyRadioButton">

                <RadioButton
                    android:id="@+id/rbsalsman"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:checked="true"
                    android:text="Salesman"
                    android:textSize="@dimen/_12sdp"
                    android:textColor="@color/white" />

                <RadioButton
                    android:id="@+id/rbPicker"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Picker"
                    android:visibility="invisible"
                    android:textSize="@dimen/_12sdp"
                    android:textColor="@color/white" />

                <RadioButton
                    android:id="@+id/rbChecker"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:visibility="invisible"
                    android:text="Checker"
                    android:textSize="@dimen/_12sdp"
                    android:textColor="@color/white" />

                <RadioButton
                    android:id="@+id/rbLoader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Loader"
                    android:visibility="invisible"
                    android:textSize="@dimen/_12sdp"
                    android:textColor="@color/white" />
            </RadioGroup>

            <LinearLayout
                android:id="@+id/ll_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:gravity="center"
                android:padding="24dp"
                android:weightSum="2">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cv_login"
                    android:layout_width="0dp"
                    android:layout_height="50dp"
                    android:layout_gravity="center"
                    android:layout_weight="1"
                    app:cardCornerRadius="25dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/colorWhite"
                    app:strokeWidth="2dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_margin="2dp"
                        android:background="@drawable/capsule_bg_gradient"
                        android:gravity="center">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text="Login"
                            android:textAllCaps="true"
                            android:textColor="@color/colorWhite"
                            android:textSize="@dimen/_12sdp"
                            app:fontPath="@string/bold_font" />

                    </LinearLayout>


                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="@dimen/_12sdp">

                <TextView
                    android:id="@+id/tv_company"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentBottom="true"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="0dp"
                    android:gravity="center|bottom"
                    android:text="Powered By: Mobiato"
                    android:textAppearance="@style/Base.TextAppearance.AppCompat.Small"
                    android:textColor="#1EADC7" />

                <ImageView
                    android:id="@+id/ivLogoMobiato"
                    android:layout_width="@dimen/_80sdp"
                    android:layout_height="@dimen/_30sdp"
                    android:layout_above="@id/tv_company"
                    android:layout_centerHorizontal="true"
                    android:src="@drawable/logo_login" />

                <TextView
                    android:id="@+id/tvAppInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_above="@id/ivLogoMobiato"
                    android:layout_centerHorizontal="true"
                    android:layout_marginBottom="@dimen/_20sdp"
                    android:gravity="center|bottom"
                    android:text="Version 1.0"
                    android:textAppearance="@style/Base.TextAppearance.AppCompat.Small"
                    android:textColor="@color/colorBlack" />
            </RelativeLayout>
        </LinearLayout>
    </FrameLayout>

</layout>