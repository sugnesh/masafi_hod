<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/headerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/_5sdp"
            android:background="@color/colorBlack"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/textcutomercode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Base.TextAppearance.AppCompat.Subhead"
                android:textColor="@color/colorWhite"
                app:fontPath="@string/regular_font"
                android:textSize="@dimen/_10sdp"
                android:gravity="center"
                android:layout_weight="1"

                tools:text="Customer Code" />
            <TextView
                android:id="@+id/textCustomerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Base.TextAppearance.AppCompat.Subhead"
                android:textColor="@color/colorWhite"
                app:fontPath="@string/regular_font"
                android:textSize="@dimen/_10sdp"
                android:gravity="center"
                android:layout_weight="1"
                tools:text="Customer Code" />
            <TextView
                android:id="@+id/textInvoceNo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Base.TextAppearance.AppCompat.Subhead"
                android:textColor="@color/colorWhite"
                app:fontPath="@string/regular_font"
                android:textSize="@dimen/_10sdp"
                android:gravity="center"
                android:layout_weight="1"
                tools:text="Invoice No" />
            <TextView
                android:id="@+id/textNetSale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Base.TextAppearance.AppCompat.Subhead"
                android:textColor="@color/colorWhite"
                app:fontPath="@string/regular_font"
                android:textSize="@dimen/_10sdp"
                android:gravity="center"
                android:layout_weight="1"
                tools:text="Net Sale" />

            <TextView
                android:id="@+id/textTotalsale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/Base.TextAppearance.AppCompat.Subhead"
                android:textColor="@color/colorWhite"
                app:fontPath="@string/regular_font"
                android:textSize="@dimen/_10sdp"
                android:gravity="center"
                android:layout_weight="1"
                tools:text="Total Sale" />

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorWhite"
            android:orientation="horizontal"
            android:padding="@dimen/_5sdp"
            tools:ignore="MissingConstraints">

            <TextView
                android:id="@+id/tvcutomercode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textAppearance="@style/Base.TextAppearance.AppCompat.Subhead"
                android:textColor="@color/colorBlack"
                android:textSize="@dimen/_10sdp"
                app:fontPath="@string/regular_font"

                tools:text="Customer Code" />

            <TextView
                android:id="@+id/tvCustomerName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textAppearance="@style/Base.TextAppearance.AppCompat.Subhead"
                android:textColor="@color/colorBlack"
                android:textSize="@dimen/_10sdp"
                app:fontPath="@string/regular_font"
                tools:text="Customer Code" />

            <TextView
                android:id="@+id/tvInvoceNo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textAppearance="@style/Base.TextAppearance.AppCompat.Subhead"
                android:textColor="@color/colorBlack"
                android:textSize="@dimen/_10sdp"
                app:fontPath="@string/regular_font"
                tools:text="Invoice No" />

            <TextView
                android:id="@+id/tvNetSale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textAppearance="@style/Base.TextAppearance.AppCompat.Subhead"
                android:textColor="@color/colorBlack"
                android:textSize="@dimen/_10sdp"
                app:fontPath="@string/regular_font"
                tools:text="Net Sale" />

            <TextView
                android:id="@+id/tvTotalsale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textAppearance="@style/Base.TextAppearance.AppCompat.Subhead"
                android:textColor="@color/colorBlack"
                android:textSize="@dimen/_10sdp"
                app:fontPath="@string/regular_font"
                tools:text="Total Sale" />

        </LinearLayout>
    </LinearLayout>
</layout>