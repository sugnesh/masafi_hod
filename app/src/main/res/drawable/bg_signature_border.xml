<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- white background -->
    <solid android:color="@android:color/white"/>

    <!-- border -->
    <stroke
        android:width="1dp"
        android:color="#000000"/>

    <!-- rounded corners (optional) -->
    <corners android:radius="6dp"/>

    <!-- inner padding -->
    <padding
        android:left="6dp"
        android:top="6dp"
        android:right="6dp"
        android:bottom="6dp"/>
</shape>
