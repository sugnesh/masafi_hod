<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:context=".activity.InputDialogOrderActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/colorWhite"
            android:gravity="center"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@android:color/white"
                    app:cardCornerRadius="6dp"
                    app:cardElevation="2dp">

                    <LinearLayout
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/_8sdp"
                        android:orientation="vertical"
                        android:padding="@dimen/_8sdp">

                        <TextView
                            android:id="@+id/txt_name"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxEms="12"
                            android:text="SAHHA MUSHROOM SLICE CAN 6X2840GM NAJAH"
                            android:textColor="@color/colorButtonBg"
                            android:textSize="@dimen/_14sdp" />

                        <TextView
                            android:id="@+id/tv_available_qty"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_8sdp"
                            android:text="Available Qty: KG : 8 | KG : 0.52"
                            android:textColor="@color/colorRed"
                            android:textSize="@dimen/_14sdp" />

                        <TextView
                            android:id="@+id/tv_salesAlloca_qty"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_8sdp"
                            android:text="Available Qty: KG : 8 | KG : 0.52"
                            android:textColor="@color/color_blue"
                            android:visibility="gone"
                            android:textSize="@dimen/_14sdp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_8sdp">

                            <TextView
                                android:id="@+id/titleQty"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Selling Qty :"
                                android:textColor="@color/colorBlack"
                                android:textSize="@dimen/_14sdp" />

                            <androidx.appcompat.widget.AppCompatImageView
                                android:id="@+id/ivAddQty"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:padding="@dimen/_2sdp"
                                app:srcCompat="@drawable/ic_add_circle" />

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="@dimen/_32sdp"
                                    android:layout_marginTop="@dimen/_16sdp"
                                    android:layout_marginRight="@dimen/_16sdp"
                                    android:layout_weight="1"
                                    android:background="@drawable/spinner_bg"
                                    android:orientation="vertical">

                                    <Spinner
                                        android:id="@+id/qtySpinner"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:dropDownWidth="match_parent"
                                        android:spinnerMode="dropdown"
                                        android:visibility="visible" />
                                </LinearLayout>

                                <EditText
                                    android:id="@+id/etQty"
                                    android:layout_width="0dp"
                                    android:layout_height="@dimen/_32sdp"
                                    android:layout_marginTop="@dimen/_16sdp"
                                    android:layout_weight="1"
                                    android:background="@drawable/spinner_bg"
                                    android:hint="Qty"
                                    android:inputType="numberDecimal"
                                    android:overlapAnchor="false"
                                    android:paddingLeft="@dimen/_8sdp"
                                    android:visibility="visible" />

                            </LinearLayout>

                            <TextView
                                android:id="@+id/titlePrice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_10sdp"
                                android:text="Price :"
                                android:textColor="@color/colorBlack"
                                android:textSize="@dimen/_12sdp" />

                            <EditText
                                android:id="@+id/etPrice"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_32sdp"
                                android:layout_marginTop="@dimen/_2sdp"
                                android:background="@drawable/spinner_bg"
                                android:focusable="false"
                                android:inputType="numberDecimal"
                                android:overlapAnchor="false"
                                android:paddingLeft="@dimen/_8sdp"
                                android:text="10000"
                                android:visibility="visible" />


                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/llBatch"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_8sdp"
                                android:text="Select Batch :"
                                android:textColor="@color/colorBlack"
                                android:textSize="@dimen/_14sdp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_8sdp"
                                android:layout_marginBottom="@dimen/_8sdp"
                                android:background="@drawable/spinner_bg">

                                <Spinner
                                    android:id="@+id/batchSpinner"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:dropDownWidth="match_parent"
                                    android:focusableInTouchMode="true"
                                    android:overlapAnchor="false"
                                    android:spinnerMode="dropdown" />

                            </LinearLayout>

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/llReason"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_8sdp"
                                android:text="Select Reason :"
                                android:textColor="@color/colorBlack"
                                android:textSize="@dimen/_14sdp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/_32sdp"
                                android:layout_marginTop="@dimen/_8sdp"
                                android:layout_marginBottom="@dimen/_8sdp"
                                android:background="@drawable/spinner_bg">

                                <Spinner
                                    android:id="@+id/reasonSpinner"
                                    android:layout_width="match_parent"
                                    android:layout_height="fill_parent"
                                    android:dropDownWidth="match_parent"
                                    android:focusableInTouchMode="true"
                                    android:overlapAnchor="false"
                                    android:spinnerMode="dropdown" />

                            </LinearLayout>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/etExpiry"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_36sdp"
                            android:layout_marginTop="@dimen/_8sdp"
                            android:background="@drawable/spinner_bg"
                            android:gravity="center_vertical"
                            android:hint="Expiry Date(yyyy-MM-dd)"
                            android:inputType="text"
                            android:overlapAnchor="false"
                            android:paddingLeft="@dimen/_8sdp"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/llInvRef"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_8sdp"
                                android:text="Select Invoice :"
                                android:textColor="@color/colorBlack"
                                android:textSize="@dimen/_14sdp" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/_8sdp"
                                android:layout_marginBottom="@dimen/_8sdp"
                                android:background="@drawable/spinner_bg">

                                <TextView
                                    android:id="@+id/invoiceSpinner"
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/_30sdp" />

                            </LinearLayout>

                        </LinearLayout>

                        <EditText
                            android:id="@+id/etComment"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_60sdp"
                            android:layout_marginTop="@dimen/_8sdp"
                            android:background="@drawable/spinner_bg"
                            android:gravity="top"
                            android:hint="Enter Comment"
                            android:inputType="text"
                            android:overlapAnchor="false"
                            android:padding="@dimen/_5sdp"
                            android:visibility="gone" />

                        <EditText
                            android:id="@+id/etBatch"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_36sdp"
                            android:layout_marginTop="@dimen/_8sdp"
                            android:background="@drawable/spinner_bg"
                            android:hint="Enter Batch"
                            android:inputType="number"
                            android:overlapAnchor="false"
                            android:paddingLeft="@dimen/_8sdp"
                            android:visibility="gone" />



                        <LinearLayout
                            android:id="@+id/ll_uom"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/_16sdp"
                            android:background="@drawable/spinner_bg"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:padding="@dimen/_4sdp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.5"
                                    android:text="UOM"
                                    android:textAlignment="center"
                                    android:textColor="@color/colorBlack"
                                    android:textSize="@dimen/_10sdp"
                                    app:fontPath="@string/bold_font" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.5"
                                    android:text="QTY"
                                    android:textAlignment="center"
                                    android:textColor="@color/colorBlack"
                                    android:textSize="@dimen/_10sdp"
                                    app:fontPath="@string/bold_font" />

                                <TextView
                                    android:id="@+id/txtBatch"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Batch"
                                    android:textAlignment="center"
                                    android:textColor="@color/colorBlack"
                                    android:textSize="@dimen/_10sdp"
                                    android:visibility="gone"
                                    app:fontPath="@string/bold_font" />

                                <TextView
                                    android:id="@+id/txtExepiry"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Expiry"
                                    android:textAlignment="center"
                                    android:textColor="@color/colorBlack"
                                    android:textSize="@dimen/_10sdp"
                                    android:visibility="gone"
                                    app:fontPath="@string/bold_font" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="0.5"
                                    android:text="Price"
                                    android:textAlignment="center"
                                    android:textColor="@color/colorBlack"
                                    android:textSize="@dimen/_10sdp"
                                    app:fontPath="@string/bold_font" />

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="Action"
                                    android:textAlignment="center"
                                    android:textColor="@color/colorBlack"
                                    android:textSize="@dimen/_10sdp"
                                    app:fontPath="@string/bold_font" />

                            </LinearLayout>

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rvQtyList"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:nestedScrollingEnabled="false" />

                        </LinearLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <TextView
                android:id="@+id/tvErrorMsg"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/_8sdp"
                android:layout_marginTop="@dimen/_8sdp"
                android:text=""
                android:textColor="@color/colorRed"
                android:textSize="@dimen/_14sdp" />

            <LinearLayout
                android:id="@+id/ll_btn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_16sdp"
                android:layout_marginBottom="@dimen/_20sdp"
                android:gravity="center"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_confirm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginRight="@dimen/_20sdp"
                    android:backgroundTint="@color/colorButtonBg"
                    android:paddingLeft="@dimen/_22sdp"
                    android:paddingTop="@dimen/_10sdp"
                    android:paddingRight="@dimen/_22sdp"
                    android:paddingBottom="@dimen/_10sdp"
                    android:text="Confirm"
                    android:textColor="@color/colorWhite"
                    app:cornerRadius="@dimen/_30sdp" />

                <Button
                    android:id="@+id/btn_cancel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/_20sdp"
                    android:backgroundTint="@color/colorGrey_200"
                    android:paddingLeft="@dimen/_22sdp"
                    android:paddingTop="@dimen/_10sdp"
                    android:paddingRight="@dimen/_22sdp"
                    android:paddingBottom="@dimen/_10sdp"
                    android:text="Cancel"
                    android:textColor="@color/colorWhite"
                    app:cornerRadius="@dimen/_30sdp" />

            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
</layout>