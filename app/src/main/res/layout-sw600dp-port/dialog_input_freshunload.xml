<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical">

        <androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
            xmlns:card_view="http://schemas.android.com/apk/res-auto"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            card_view:cardBackgroundColor="@android:color/white"
            card_view:cardCornerRadius="6dp"
            card_view:cardElevation="2dp">

            <LinearLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/_10sdp"
                android:orientation="vertical"
                android:padding="@dimen/_10sdp">

                <TextView
                    android:id="@+id/txt_name"
                    fontPath="@string/regular_font"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:gravity="left"
                    android:maxEms="12"
                    android:text="NAME"
                    android:textAppearance="@style/Base.TextAppearance.AppCompat.Medium"
                    android:textColor="@color/colorPrimary" />

                <TextView
                    android:id="@+id/tvSystem"
                    fontPath="@string/regular_font"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_5sdp"
                    android:maxEms="12"
                    android:textAppearance="@style/Base.TextAppearance.AppCompat.Subhead"
                    tools:text="System Qty : 3 Bag | 2 KG" />


                <!-- Empty Layout -->
                <LinearLayout
                    android:id="@+id/ll_UOM"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_10sdp"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <TextView
                        fontPath="@string/regular_font"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1.3"
                        android:gravity="left"
                        android:maxEms="12"
                        android:text="Select UOM"
                        android:textAppearance="@style/Base.TextAppearance.AppCompat.Subhead" />

                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_34sdp"
                        android:layout_marginLeft="@dimen/_6sdp"
                        android:layout_weight="1.7"
                        android:background="@drawable/rounded_row_cust"
                        android:orientation="horizontal">

                        <Spinner
                            android:id="@+id/edtUOM"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:dropDownWidth="match_parent"
                            android:spinnerMode="dropdown" />

                    </RelativeLayout>
                </LinearLayout>
                <!-- Empty Layout -->
                <LinearLayout
                    android:id="@+id/ll_empty"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <TextView
                        fontPath="@string/regular_font"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1.3"
                        android:gravity="left"
                        android:maxEms="12"
                        android:text="Enter VR Qty"
                        android:textAppearance="@style/Base.TextAppearance.AppCompat.Subhead" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_6sdp"
                        android:layout_weight="1.7"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/edt_act_alter"
                            android:layout_width="fill_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/rounded_row_cust"
                            android:ems="3"
                            android:hint="0"
                            android:inputType="numberDecimal"
                            android:lines="1"
                            android:padding="@dimen/_6sdp"
                            android:textAppearance="@style/Base.TextAppearance.AppCompat.Subhead"
                            android:textColor="@color/darkBlack"
                            android:textColorHint="@color/darkBlack" />

                    </LinearLayout>
                </LinearLayout>
                <!-- Empty Layout -->
                <LinearLayout
                    android:id="@+id/ll_reason"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:orientation="horizontal"
                    android:weightSum="3">

                    <TextView
                        fontPath="@string/regular_font"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1.3"
                        android:gravity="left"
                        android:maxEms="12"
                        android:text="Reason"
                        android:textAppearance="@style/Base.TextAppearance.AppCompat.Subhead" />

                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_34sdp"
                        android:layout_marginLeft="@dimen/_6sdp"
                        android:layout_weight="1.7"
                        android:background="@drawable/rounded_row_cust"
                        android:orientation="horizontal">

                        <Spinner
                            android:id="@+id/edtReason"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:dropDownWidth="match_parent"
                            android:spinnerMode="dropdown" />

                    </RelativeLayout>
                </LinearLayout>
                <!-- Empty Layout -->
                <LinearLayout
                    android:id="@+id/ll_batch"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_6sdp"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:weightSum="3">

                    <TextView
                        fontPath="@string/regular_font"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_weight="1.3"
                        android:gravity="left"
                        android:maxEms="12"
                        android:text="Batch"
                        android:textAppearance="@style/Base.TextAppearance.AppCompat.Subhead" />

                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_34sdp"
                        android:layout_marginLeft="@dimen/_6sdp"
                        android:layout_weight="1.7"
                        android:background="@drawable/rounded_row_cust"
                        android:orientation="horizontal">

                        <Spinner
                            android:id="@+id/edtBatch"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:dropDownWidth="match_parent"
                            android:spinnerMode="dropdown" />

                    </RelativeLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_18sdp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_confirm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginRight="@dimen/_20sdp"
                        android:backgroundTint="@color/colorButtonBg"
                        android:paddingLeft="@dimen/_22sdp"
                        android:paddingTop="@dimen/_10sdp"
                        android:paddingRight="@dimen/_22sdp"
                        android:paddingBottom="@dimen/_10sdp"
                        android:text="Save"
                        android:textColor="@color/colorWhite"
                        app:cornerRadius="@dimen/_30sdp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_cancel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/_20sdp"
                        android:backgroundTint="@color/colorGrey_200"
                        android:paddingLeft="@dimen/_22sdp"
                        android:paddingTop="@dimen/_10sdp"
                        android:paddingRight="@dimen/_22sdp"
                        android:paddingBottom="@dimen/_10sdp"
                        android:text="Cancel"
                        android:textColor="@color/colorWhite"
                        app:cornerRadius="@dimen/_30sdp" />

                </LinearLayout>

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</layout>